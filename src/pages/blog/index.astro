---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, posts } from '../../lib/notion';
---

<BaseLayout title="Blog" description="Writing and research notes from Kaituo Zhang.">
  <header class="page-intro"><p class="eyebrow">Blog</p><h1>Ideas in progress.</h1><p class="lead">Research notes, technical reflections, and the occasional useful tangent.</p></header>
  <section class="section"><ol class="post-list">{posts.map((post) => <li><time datetime={post.publishedDate}>{formatDate(post.publishedDate)}</time><div><h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3><p>{post.summary}</p><div class="tags">{post.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></li>)}</ol></section>
</BaseLayout>
