---
import BaseLayout from '../layouts/BaseLayout.astro';
import { news, projects } from '../data/site';
---

<BaseLayout description="Kaituo Zhang is an AI researcher and engineer working on trustworthy language models, synthetic data, and anomaly detection.">
  <section class="hero">
    <div><p class="eyebrow">AI Researcher · Engineer</p><h1>Curiosity<br /><span>meets rigor.</span></h1><p class="lead">I’m Kaituo Zhang. I study trustworthy and capable AI systems, with a focus on large language models, synthetic data evaluation, and unsupervised anomaly detection.</p></div>
    <aside class="hero-side" aria-label="Current position"><p class="label">Currently</p><p>PhD Candidate and Research Assistant<br />University of Houston</p><div class="hero-links"><a href="/research/">Research</a><a href="mailto:kzhang42@cougarnet.uh.edu">Contact</a></div></aside>
  </section>
  <blockquote class="verse-card">
    <span class="verse-symbol" aria-hidden="true">✦</span>
    <p>“The LORD is my shepherd; I have all that I need.”</p>
    <cite>Psalm 23:1 · NLT</cite>
  </blockquote>
  <section class="section">
    <div class="section-heading"><span class="section-number">01 / Updates</span><h2>Recent news</h2></div>
    <ol class="news-list">{news.map((item) => <li><time>{item.date}</time><span>{item.text}<span class="inline-links">{item.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}</span></span></li>)}</ol>
  </section>
  <section class="section">
    <div class="section-heading"><span class="section-number">02 / Selected work</span><h2>Research made useful</h2></div>
    <div class="card-grid">{projects.map((project) => <a class="card" href={project.href}><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div>
  </section>
</BaseLayout>
