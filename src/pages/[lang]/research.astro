---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, languages, publications, type Lang } from '../../data/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: Lang; }
const { lang } = Astro.props; const c = copy[lang].research;
---
<BaseLayout lang={lang} title={c.kicker} description={c.title}>
  <header class="page-intro"><p class="eyebrow">{c.kicker}</p><h1>{c.title}</h1></header>
  <section class="publications" aria-labelledby="publications-title">
    <div class="section-heading"><span class="section-number">01</span><h2 id="publications-title">Publications</h2></div>
    <div class="publication-list">
      {publications.map((paper) => <article class="publication-row">
        <div class="paper-mark"><strong>{paper.mark}</strong><span>{paper.year}</span></div>
        <div class="paper-details">
          <p class="paper-venue">{paper.venue} · {paper.year}</p>
          <h3>{paper.title}</h3>
          <p class="paper-authors">{paper.authors.map((author, index) => <>{index > 0 && ', '}<span class:list={{ 'me': author === 'Kaituo Zhang' }}>{author}</span></>)}</p>
          <p class="paper-summary">{paper[lang]}</p>
          <div class="paper-links">{paper.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}</div>
        </div>
      </article>)}
    </div>
  </section>
  <div class="section-heading research-heading"><span class="section-number">02</span><h2>{lang === 'zh' ? '研究方向' : 'Research areas'}</h2></div>
  <section class="research-list">
    {c.areas.map((area, index) => <article><span>0{index + 1}</span><div><h2>{area[0]}</h2><p>{area[1]}</p></div></article>)}
  </section>
</BaseLayout>
