---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, languages, localePath, news, projects, type Lang } from '../../data/site';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = copy[lang];
---

<BaseLayout lang={lang} description={c.hero.intro}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{c.hero.kicker}</p>
      <h1>{c.hero.title}</h1>
      <p class="lead">{c.hero.intro}</p>
      <div class="focus-row" aria-label={c.labels.focus}>
        <span>Trustworthy LLMs</span><span>Synthetic Data</span><span>Anomaly Detection</span>
      </div>
    </div>
    <figure class="portrait-card">
      <img src="/kaituo-sunset.jpg" alt={lang === 'zh' ? '章凯拓在夕阳下眺望远方' : 'Kaituo Zhang looking toward a sunset'} />
      <figcaption><span>{c.hero.role}</span><span>{c.hero.place}</span></figcaption>
    </figure>
  </section>

  <blockquote class="verse-card">
    <span aria-hidden="true">“</span>
    <p>{c.verse}</p>
    <cite>{c.verseRef}</cite>
  </blockquote>

  <section class="section">
    <div class="section-heading"><span class="section-number">01</span><h2>{c.labels.news}</h2></div>
    <ol class="news-list">
      {news.map((item) => <li><time>{item.date}</time><span>{item[lang]}<span class="inline-links">{item.links.map((link) => <a href={link.href}>{link.label} ↗</a>)}</span></span></li>)}
    </ol>
  </section>

  <section class="section">
    <div class="section-heading"><span class="section-number">02</span><h2>{c.labels.work}</h2></div>
    <div class="card-grid">
      {projects.map((project) => <a class="project-card" href={project.href}><span class="project-code">{project.code}</span><h3>{project.title}</h3><p>{project[lang]}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="project-arrow">↗</span></a>)}
    </div>
  </section>
</BaseLayout>
