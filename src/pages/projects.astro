---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site';
---

<BaseLayout title="Projects" description="Selected research and software projects by Kaituo Zhang.">
  <header class="page-intro"><p class="eyebrow">Projects</p><h1>Research artifacts and practical tools.</h1></header>
  <section class="section"><div class="card-grid">{projects.map((project) => <a class="card" href={project.href}><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div></section>
</BaseLayout>
